--- The copy the second run used - one line, and nothing else

$ diff -u scripts/checks/S18.sh scripts/checks/S18-claim-patched.sh
--- scripts/checks/S18.sh	2026-09-13 00:37:57
+++ scripts/checks/S18-claim-patched.sh	2026-09-13 02:13:37
@@ -34,7 +34,7 @@
 fail() { echo "FAIL: $1"; exit 1; }
 ok()   { echo "  ok: $1"; }
 
-TARGETS=(demo-up demo-undeploy demo-redeploy ns-delete test-up jit-up verify jit-verify jit-down destroy state targets)
+TARGETS=(demo-up demo-undeploy demo-redeploy ns-delete test-up jit-up verify jit-verify jit-down destroy state claim targets)
 
 # ---------------------------------------------------------------- 1. allowlist exists
 target_defined() { { make -pRrq : 2>/dev/null || true; } | grep -Eq "^$1:( |$)"; }
exit=1

